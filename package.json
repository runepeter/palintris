{
  "name": "palintris",
  "version": "1.0.0",
  "description": "A palindrome puzzle game built with Phaser 3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src scripts e2e --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "build:campaign": "tsx scripts/build-campaign.ts"
  },
  "keywords": [
    "phaser",
    "game",
    "palindrome",
    "puzzle",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "fast-check": "^3.23.2",
    "tsx": "^4.23.13",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "phaser": "^3.70.0"
  }
}
